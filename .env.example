# Copy this file to .env and fill in your own keys. Never commit .env.
# Without JEV_KEY, the JEV classifier returns a result stamped "MOCK – not a result".
# Without OPENAI_API_KEY, OpenAI models are not listed and OpenAI requests return an error.

# TypeSafe JEV (early access)
JEV_KEY=
JEV_MODEL=jev-1.13.0
# Size of the "JEV · top N shortlist" option (labels chosen by the local embedding model)
JEV_SHORTLIST=15

# OpenAI: used for the LLM classifier and model discovery
OPENAI_API_KEY=

# FORCE_MOCK=1   # force the JEV classifier into mock mode even if a key is set
